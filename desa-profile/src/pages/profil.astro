---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { desa, wilayah, kontak } from "../data/desa";
---

<Layout title="Profil Desa" description={`Profil dan sejarah ${desa.nama}`}>
  <!-- Header -->
  <div class="bg-emerald-900 py-20 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
      Profil {desa.nama}
    </h1>
    <p class="text-emerald-100 text-lg max-w-2xl mx-auto px-4">
      Mengenal lebih dekat data dan wilayah kami.
    </p>
  </div>

  <Section bg="white">
    <div class="max-w-4xl mx-auto prose prose-emerald prose-lg">


      <h2 class="text-2xl font-bold text-gray-900 mb-6">Data Wilayah</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white border border-gray-200 shadow-sm rounded-xl p-6">
          <h3 class="text-lg font-bold text-gray-900 border-b pb-3 mb-4">
            Statistik
          </h3>
          <ul class="space-y-3 text-gray-700">
            <!-- <li class="flex justify-between"><span>Luas Wilayah:</span> <span class="font-bold">{wilayah.luas}</span></li>
            <li class="flex justify-between"><span>Jumlah Dusun:</span> <span class="font-bold">{wilayah.jumlahDusun}</span></li> -->
            <li class="flex justify-between">
              <span>Jumlah KK:</span>
              <span class="font-bold">{wilayah.jumlahKK}</span>
            </li>
            <li class="flex justify-between">
              <span>Jumlah RT:</span>
              <span class="font-bold">{wilayah.jumlahRT}</span>
            </li>
            <li class="flex justify-between">
              <span>Jumlah RW:</span>
              <span class="font-bold">{wilayah.jumlahRW}</span>
            </li>
          </ul>
        </div>

        <div
          class="bg-white border border-gray-200 shadow-sm rounded-xl p-6 relative"
        >
          <h3
            class="text-lg font-bold text-gray-900 border-b pb-3 mb-4 text-center"
          >
            Batas Wilayah
          </h3>

          <!-- Google Maps Embed -->
          <div class="w-full h-96 rounded-xl overflow-hidden shadow-sm border border-gray-200">
            <iframe
              src={kontak.gmaps}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </Section>
</Layout>
