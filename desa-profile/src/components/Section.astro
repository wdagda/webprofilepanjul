---
interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
  id?: string;
  bg?: 'white' | 'gray';
}

const { title, subtitle, className = '', id, bg = 'white' } = Astro.props;
const bgColor = bg === 'gray' ? 'bg-gray-50' : 'bg-white';
---

<section id={id} class={`py-16 md:py-24 ${bgColor} ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {(title || subtitle) && (
      <div class="text-center max-w-3xl mx-auto mb-16">
        {title && <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">{title}</h2>}
        {subtitle && <p class="text-lg text-gray-600">{subtitle}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
