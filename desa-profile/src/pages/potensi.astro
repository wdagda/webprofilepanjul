---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { desa } from '../data/desa';

const umkmList = await getCollection('umkm');
---

<Layout title="Potensi Desa" description="Potensi UMKM, Pertanian, dan Wisata">
  <div class="bg-emerald-900 py-20 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Potensi Desa</h1>
    <p class="text-emerald-100 text-lg max-w-2xl mx-auto px-4">Menggali dan memberdayakan potensi lokal {desa.nama} untuk kesejahteraan bersama.</p>
  </div>

  <Section title="UMKM & Usaha Lokal" subtitle="Produk dan jasa unggulan karya warga desa." bg="white">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {umkmList.map((umkm) => (
        <Card 
          title={umkm.data.namaUsaha} 
          description={umkm.data.deskripsi} 
          image={umkm.data.foto} 
          badge="UMKM"
        >
          <div class="mt-4 pt-4 border-t border-gray-100">
            <p class="text-sm text-gray-500 mb-1"><strong>Pemilik:</strong> {umkm.data.pemilik}</p>
            {umkm.data.kontak && (
              <a href={`https://wa.me/${umkm.data.kontak}`} class="inline-flex items-center text-sm font-medium text-emerald-600 hover:text-emerald-700">
                Hubungi via WhatsApp
                <svg class="ml-1 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            )}
          </div>
        </Card>
      ))}
    </div>
  </Section>
</Layout>
