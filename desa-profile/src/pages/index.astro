---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import { desa, wilayah } from "../data/desa";
---

<Layout title="Beranda">
  <!-- Hero Section -->
  <section
    class="relative bg-emerald-900 text-white min-h-[80vh] flex items-center justify-center overflow-hidden"
  >
    <div class="absolute inset-0 z-0">
      <!-- TODO: Ganti foto background hero dengan pemandangan desa -->
      <img
        src="https://placehold.co/1920x1080/2a4b3d/ffffff?text=Pemandangan+Desa"
        alt="Pemandangan Desa"
        class="w-full h-full object-cover opacity-40 mix-blend-overlay"
      />
    </div>
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <span
        class="inline-block py-1 px-3 rounded-full bg-emerald-500/30 border border-emerald-400/50 text-emerald-100 text-sm font-semibold tracking-wider mb-6"
      >
        SELAMAT DATANG DI
      </span>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
        {desa.nama}
      </h1>
      <p
        class="text-lg md:text-2xl text-emerald-50 mb-10 max-w-2xl mx-auto leading-relaxed"
      >
        Menuju desa yang mandiri, sejahtera, dan berbudaya dengan semangat
        kebersamaan warga.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/profil"
          class="bg-emerald-500 hover:bg-emerald-600 text-white px-8 py-4 rounded-full font-bold text-lg transition-all shadow-lg hover:shadow-emerald-500/30"
        >
          Kenali Lebih Dekat
        </a>
      </div>
    </div>
  </section>

  <!-- Sekilas Profil -->
  <Section title="Sekilas Profil" subtitle={desa.visi} bg="white">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          {desa.sejarah}
        </p>
        <a
          href="/profil"
          class="text-emerald-600 font-bold hover:text-emerald-700 flex items-center gap-2 group"
        >
          Baca sejarah lengkap
          <svg
            class="w-5 h-5 group-hover:translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-emerald-50 p-6 rounded-2xl text-center col-span-2">
          <div class="text-3xl font-extrabold text-emerald-600 mb-2">
            {wilayah.jumlahRT}
          </div>
          <div
            class="text-sm font-medium text-emerald-900 uppercase tracking-wide"
          >
            Jumlah RT
          </div>
        </div>
        <div class="bg-emerald-50 p-6 rounded-2xl text-center col-span-2">
          <div class="text-3xl font-extrabold text-emerald-600 mb-2">
            {wilayah.jumlahRW}
          </div>
          <div
            class="text-sm font-medium text-emerald-900 uppercase tracking-wide"
          >
            Jumlah RW
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Layanan Cepat -->
  <Section title="Informasi & Layanan" bg="gray">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <Card
        title="Pemerintahan"
        description="Struktur organisasi dan perangkat desa yang bertugas melayani masyarakat."
        link="/pemerintahan"
      />
      <Card
        title="Fasilitas Umum"
        description="Daftar fasilitas pendidikan, kesehatan, dan tempat ibadah di wilayah kami."
        link="/informasi"
      />
      <Card
        title="Galeri Dokumentasi"
        description="Kumpulan foto kegiatan warga, pembangunan, dan potensi desa."
        link="/galeri"
      />
    </div>
  </Section>
</Layout>
