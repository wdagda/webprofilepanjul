---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getCollection } from 'astro:content';

const galeri = await getCollection('galeri');

// Get unique categories for filtering
const categories = [...new Set(galeri.map((item) => item.data.kategori))];
---

<Layout title="Galeri Dokumentasi" description="Galeri foto kegiatan dan potensi desa">
  <div class="bg-emerald-900 py-20 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Galeri Dokumentasi</h1>
    <p class="text-emerald-100 text-lg max-w-2xl mx-auto px-4">Merekam momen kebersamaan, pembangunan, dan keindahan desa kami.</p>
  </div>

  <Section bg="white">
    <!-- Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <button class="filter-btn active px-6 py-2 rounded-full text-sm font-bold transition-all bg-emerald-600 text-white shadow-md" data-filter="all">Semua</button>
      {categories.map((cat) => (
        <button class="filter-btn px-6 py-2 rounded-full text-sm font-medium transition-all bg-gray-100 text-gray-600 hover:bg-gray-200" data-filter={cat}>{cat}</button>
      ))}
    </div>

    <!-- Masonry Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6" id="gallery-grid">
      {galeri.map((item) => (
        <div class="gallery-item group relative overflow-hidden rounded-2xl shadow-sm cursor-pointer" data-category={item.data.kategori}>
          <img src={item.data.foto} alt={item.data.judul} class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
            <span class="text-emerald-400 text-xs font-bold uppercase tracking-wider mb-1">{item.data.kategori}</span>
            <h3 class="text-white text-lg font-bold">{item.data.judul}</h3>
          </div>
        </div>
      ))}
    </div>
  </Section>
</Layout>

<script>
  // Simple filtering logic
  const filterBtns = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state
      filterBtns.forEach(b => {
        b.classList.remove('bg-emerald-600', 'text-white', 'shadow-md', 'font-bold');
        b.classList.add('bg-gray-100', 'text-gray-600', 'font-medium');
      });
      btn.classList.add('bg-emerald-600', 'text-white', 'shadow-md', 'font-bold');
      btn.classList.remove('bg-gray-100', 'text-gray-600', 'font-medium');

      const filter = btn.getAttribute('data-filter');

      // Filter items
      galleryItems.forEach(item => {
        if (filter === 'all' || item.getAttribute('data-category') === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
