---
import { desa } from '../data/desa';

const links = [
  { text: 'Beranda', href: '/' },
  { text: 'Profil', href: '/profil' },
  { text: 'Pemerintahan', href: '/pemerintahan' },
  { text: 'Fasilitas & Kegiatan', href: '/informasi' },
  { text: 'Galeri', href: '/galeri' },
  { text: 'MAT Kualitas', href: '/mat' },
];
---

<header class="fixed top-0 left-0 right-0 w-full z-50 bg-white/90 backdrop-blur-md shadow-sm border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2">
          <span class="font-bold text-xl text-gray-900 tracking-tight">{desa.nama}</span>
        </a>
      </div>

      <!-- Desktop Menu -->
      <nav class="hidden md:flex space-x-8">
        {links.map((link) => (
          <a
            href={link.href}
            class="text-gray-600 hover:text-emerald-600 px-3 py-2 text-sm font-medium transition-colors"
          >
            {link.text}
          </a>
        ))}
      </nav>

      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-emerald-500"
          aria-expanded="false"
        >
          <span class="sr-only">Buka menu utama</span>
          <!-- Icon when menu is closed -->
          <svg class="block h-6 w-6 menu-icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Icon when menu is open -->
          <svg class="hidden h-6 w-6 menu-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="md:hidden hidden bg-white border-b border-gray-100" id="mobile-menu">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      {links.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-emerald-600 hover:bg-gray-50"
        >
          {link.text}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconClose = document.querySelector('.menu-icon-close');
  const iconOpen = document.querySelector('.menu-icon-open');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
    });
  }
</script>
